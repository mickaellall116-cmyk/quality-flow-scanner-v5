//@version=6
strategy("Quality Flow System V1.7 AUTO Hybrid",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10,
     pyramiding=0)

// ===== Inputs =====
emaFastLen = input.int(21, "EMA Fast")
emaSlowLen = input.int(55, "EMA Slow")
emaSlopeLen = input.int(50, "EMA Slope Length")
slopeLookback = input.int(5, "Slope Lookback")
breakoutLen = input.int(20, "Breakout Length")

cmfLen = input.int(20, "CMF Length")
mfiLen = input.int(14, "MFI Length")
mfiMin = input.int(40, "MFI Min")
mfiMax = input.int(75, "MFI Max")

atrLen = input.int(14, "ATR Length")
atrBaseLen = input.int(50, "ATR Baseline")
atrMinRatio = input.float(0.85, "Min ATR Ratio")

stopATR = input.float(2.0, "Stop ATR")
tpATR = input.float(1.5, "TP1 ATR")

useAutoMode = input.bool(true, "Use Auto Hybrid Mode")
useEarlyEntry = input.bool(true, "Use Early Entry")
useAdaptive200 = input.bool(true, "Use Adaptive 200 EMA")
useSmartExits = input.bool(true, "Use Smart Exits")
useExitConfirm = input.bool(true, "Use 1-Bar Exit Confirmation")

manualAdxMin = input.float(15.0, "Manual ADX Min")
manualRunnerATR = input.float(3.5, "Manual Runner ATR")

cryptoAdxMin = input.float(12.0, "Crypto ADX Min")
cryptoRunnerATR = input.float(4.5, "Crypto Runner ATR")

stockAdxMin = input.float(15.0, "Stock ADX Min")
stockRunnerATR = input.float(3.5, "Stock Runner ATR")

indexAdxMin = input.float(22.0, "Index/ETF ADX Min")
indexRunnerATR = input.float(3.0, "Index/ETF Runner ATR")

adxLen = input.int(14, "ADX Length")

cooldownCrypto = input.int(3, "Crypto Cooldown")
cooldownStock = input.int(7, "Stock Cooldown")
cooldownIndex = input.int(12, "Index Cooldown")

maxEntriesCrypto = input.int(4, "Crypto Max Entries")
maxEntriesStock = input.int(3, "Stock Max Entries")
maxEntriesIndex = input.int(2, "Index Max Entries")

useCMFExit = input.bool(true, "Use CMF Exit")
useMFIExit = input.bool(false, "Use MFI Exit")
trendConfirmBars = input.int(2, "EMA 55 Exit Confirm Bars")
extraTrendTrailATR = input.float(1.0, "Extra ATR In Strong Trend")

// ===== Asset Detection =====
isCrypto = syminfo.type == "crypto"
isIndexLike = syminfo.type == "fund" or syminfo.type == "index" or syminfo.ticker == "SPY" or syminfo.ticker == "QQQ" or syminfo.ticker == "VOO"
isStock = not isCrypto and not isIndexLike

assetMode = isCrypto ? "CRYPTO" : isIndexLike ? "INDEX/ETF" : "STOCK"

activeAdxMin = useAutoMode ? isCrypto ? cryptoAdxMin : isIndexLike ? indexAdxMin : stockAdxMin : manualAdxMin
activeRunnerATR = useAutoMode ? isCrypto ? cryptoRunnerATR : isIndexLike ? indexRunnerATR : stockRunnerATR : manualRunnerATR

activeCooldown = isCrypto ? cooldownCrypto : isIndexLike ? cooldownIndex : cooldownStock
activeMaxEntries = isCrypto ? maxEntriesCrypto : isIndexLike ? maxEntriesIndex : maxEntriesStock

// ===== Indicators =====
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
emaSlopeBase = ta.ema(close, emaSlopeLen)
ema200 = ta.ema(close, 200)

atr = ta.atr(atrLen)
atrBase = ta.sma(atr, atrBaseLen)
atrRatio = atr / atrBase
atrOK = atrRatio >= atrMinRatio

[plusDI, minusDI, adx] = ta.dmi(adxLen, adxLen)
adxOK = adx >= activeAdxMin

emaSlope = emaSlopeBase - emaSlopeBase[slopeLookback]
slopeOK = emaSlope > 0

// ===== CMF =====
mfMult = ((close - low) - (high - close)) / math.max(high - low, syminfo.mintick)
mfVol = mfMult * volume
cmf = ta.sma(mfVol, cmfLen) / ta.sma(volume, cmfLen)
cmfFalling = cmf < cmf[1] and cmf[1] < cmf[2]

// ===== MFI =====
mfi = ta.mfi(hlc3, mfiLen)

// ===== OBV =====
obv = ta.cum(close > close[1] ? volume : close < close[1] ? -volume : 0)
obvUp = ta.ema(obv, 5) > ta.ema(obv, 20)

// ===== Core =====
trendBull = emaFast > emaSlow
flowOK = cmf > 0
mfiOK = mfi >= mfiMin and mfi <= mfiMax

priorHigh = ta.highest(high, breakoutLen)[1]
breakout = close > priorHigh

// ===== Adaptive 200 EMA =====
// Crypto ignores it.
// Indexes require above 200.
// Stocks use soft 200 filter.
ema200OK = not useAdaptive200 ? true :
     isCrypto ? true :
     isIndexLike ? close > ema200 :
     close > ema200 * 0.98

// ===== Regime =====
emaSpread = math.abs(emaFast - emaSlow) / close
spreadThreshold = isCrypto ? 0.003 : isIndexLike ? 0.004 : 0.006

trendRegime = adx >= activeAdxMin and atrRatio >= atrMinRatio and emaSpread > spreadThreshold
stockRegimeOK = trendRegime or (trendBull and slopeOK and atrOK)
cryptoRegimeOK = trendBull and atrOK
indexRegimeOK = trendRegime and slopeOK and ema200OK

tradeAllowed = isCrypto ? cryptoRegimeOK : isIndexLike ? indexRegimeOK : stockRegimeOK

// ===== Trend Leg Control =====
trendStart = ta.crossover(emaFast, emaSlow)

var int entriesThisTrend = 0
var int lastEntryBar = na

if trendStart
    entriesThisTrend := 0

cooldownOK = na(lastEntryBar) or bar_index - lastEntryBar >= activeCooldown
entryLimitOK = entriesThisTrend < activeMaxEntries

extensionFromEMA = math.abs(close - emaFast) / atr
extended = extensionFromEMA >= (isCrypto ? 3.5 : isIndexLike ? 2.2 : 2.8)

// Crypto can still trade extended trends.
// Stocks are cautious.
// Indexes block extended entries.
extensionOK = isCrypto ? true : isIndexLike ? not extended : extensionFromEMA < 3.2

// ===== Buy Logic =====
confirmedBuy = trendBull and breakout and flowOK and mfiOK and atrOK and adxOK and ema200OK and tradeAllowed and cooldownOK and entryLimitOK and extensionOK

// ===== Early Entry Logic =====
controlledPullback = low <= emaFast and close > emaFast and close > emaSlow
bullishCandle = close > open and close > close[1]
reclaim = close > emaFast and close[1] < emaFast[1] and close > open

earlyAllowed =
     useEarlyEntry and
     trendBull and
     flowOK and
     mfiOK and
     atrOK and
     ema200OK and
     tradeAllowed and
     cooldownOK and
     entryLimitOK and
     extensionOK

// Crypto early = looser.
// Stocks early = balanced.
// Index early = strict.
cryptoEarly = isCrypto and earlyAllowed and (controlledPullback or reclaim)
stockEarly = isStock and earlyAllowed and adxOK and slopeOK and (controlledPullback or reclaim) and bullishCandle
indexEarly = isIndexLike and earlyAllowed and trendRegime and slopeOK and adxOK and controlledPullback and bullishCandle

earlyBuy = cryptoEarly or stockEarly or indexEarly

entrySignal = strategy.position_size == 0 and (confirmedBuy or earlyBuy)

// ===== Trade State =====
var float entryPrice = na
var float stopPrice = na
var float tp1Price = na
var bool tp1Hit = false

if entrySignal
    entryPrice := close
    stopPrice := close - atr * stopATR
    tp1Price := close + atr * tpATR
    tp1Hit := false
    entriesThisTrend += 1
    lastEntryBar := bar_index
    strategy.entry("BUY", strategy.long, comment=earlyBuy ? "EARLY" : "BUY")

// ===== TP1 Partial =====
if strategy.position_size > 0 and not tp1Hit and high >= tp1Price
    tp1Hit := true
    strategy.close("BUY", qty_percent=50, comment="TP1")

// ===== Smart Runner =====
trendStrong = emaFast > emaSlow and adx >= activeAdxMin + 5

smartRunnerATR = useSmartExits and trendStrong ? activeRunnerATR + extraTrendTrailATR : activeRunnerATR

activeStop = tp1Hit ? entryPrice : stopPrice
runnerTrail = close - atr * smartRunnerATR
finalStop = tp1Hit ? math.max(activeStop, runnerTrail) : activeStop

// ===== Exits =====
cmfExit = useCMFExit and cmf < 0 and cmfFalling
mfiExit = useMFIExit and mfi > 80 and ta.falling(mfi, 2)
trendExit = math.sum(close < emaSlow ? 1 : 0, trendConfirmBars) == trendConfirmBars
stopExit = close < finalStop

// Exit behavior by asset
cryptoWeakExit = isCrypto and not trendStrong and close < emaSlow
stockWeakExit = isStock and not trendStrong and (cmf < 0 or close < emaFast)
indexWeakExit = isIndexLike and (close < emaFast or cmf < 0)

rawExit = cmfExit or mfiExit or trendExit or stopExit or cryptoWeakExit or stockWeakExit or indexWeakExit

smartExit = useSmartExits ? trendStrong ? stopExit : rawExit : rawExit
exitConfirmed = useExitConfirm ? smartExit and smartExit[1] : smartExit
exitSignal = strategy.position_size > 0 and exitConfirmed

if exitSignal
    strategy.close("BUY", comment="EXIT")

// ===== Plots =====
plot(emaFast, "EMA 21", color=color.new(color.green, 0))
plot(emaSlow, "EMA 55", color=color.new(color.red, 0))
plot(useAdaptive200 ? ema200 : na, "EMA 200", color=color.new(color.orange, 0))

plotshape(earlyBuy and strategy.position_size == 0, title="EARLY BUY", text="EARLY",
     style=shape.labelup, location=location.belowbar,
     color=color.yellow, textcolor=color.black)

plotshape(confirmedBuy and strategy.position_size == 0, title="BUY", text="BUY",
     style=shape.labelup, location=location.belowbar,
     color=color.green, textcolor=color.white)

plotshape(tp1Hit and strategy.position_size > 0, title="HOLD", text="HOLD",
     style=shape.labelup, location=location.belowbar,
     color=color.blue, textcolor=color.white)

plotshape(exitSignal, title="EXIT", text="EXIT",
     style=shape.labeldown, location=location.abovebar,
     color=color.red, textcolor=color.white)

// ===== Alerts =====
alertcondition(confirmedBuy, title="BUY Signal", message="BUY signal on {{ticker}}")
alertcondition(earlyBuy, title="EARLY BUY Signal", message="EARLY BUY signal on {{ticker}}")
alertcondition(exitSignal, title="EXIT Signal", message="EXIT signal on {{ticker}}")

// ===== Dashboard =====
var table dash = table.new(position.bottom_right, 2, 16, border_width=1)

regimeName = trendRegime ? "TREND" : tradeAllowed ? "OK" : "BLOCK"
stateName = strategy.position_size > 0 ? "HOLD" : earlyBuy ? "EARLY" : confirmedBuy ? "BUY" : "WAIT"

if barstate.islast
    table.cell(dash, 0, 0, "Asset")
    table.cell(dash, 1, 0, assetMode)

    table.cell(dash, 0, 1, "Regime")
    table.cell(dash, 1, 1, regimeName)

    table.cell(dash, 0, 2, "Trade")
    table.cell(dash, 1, 2, tradeAllowed ? "YES" : "NO")

    table.cell(dash, 0, 3, "Entries")
    table.cell(dash, 1, 3, str.tostring(entriesThisTrend) + "/" + str.tostring(activeMaxEntries))

    table.cell(dash, 0, 4, "Cooldown")
    table.cell(dash, 1, 4, cooldownOK ? "OK" : "WAIT")

    table.cell(dash, 0, 5, "Extended")
    table.cell(dash, 1, 5, extended ? "YES" : "NO")

    table.cell(dash, 0, 6, "ADX Min")
    table.cell(dash, 1, 6, str.tostring(activeAdxMin))

    table.cell(dash, 0, 7, "Runner ATR")
    table.cell(dash, 1, 7, str.tostring(activeRunnerATR))

    table.cell(dash, 0, 8, "200 EMA")
    table.cell(dash, 1, 8, ema200OK ? "OK" : "BLOCK")

    table.cell(dash, 0, 9, "Slope")
    table.cell(dash, 1, 9, slopeOK ? "UP" : "FLAT/DOWN")

    table.cell(dash, 0, 10, "CMF")
    table.cell(dash, 1, 10, cmf > 0 ? "Money In" : "Weak")

    table.cell(dash, 0, 11, "MFI")
    table.cell(dash, 1, 11, mfiOK ? "Healthy" : mfi > 75 ? "Hot" : "Weak")

    table.cell(dash, 0, 12, "OBV")
    table.cell(dash, 1, 12, obvUp ? "Confirming" : "Weak")

    table.cell(dash, 0, 13, "ATR")
    table.cell(dash, 1, 13, atrOK ? "Valid" : "Chop")

    table.cell(dash, 0, 14, "ADX")
    table.cell(dash, 1, 14, adxOK ? "Valid" : "Weak")

    table.cell(dash, 0, 15, "State")
    table.cell(dash, 1, 15, stateName)
