+    for n in cand19:
+        p_, t_ = _trial_checks(cand_m["trials"][n])
+        cp += p_
+        ct += t_
+        all_ok = all_ok and bool(cand_m["trials"][n].get("ok"))
+    combined = {"checks_passed": op + cp, "checks_total": ot + ct,
