+    acc = canonicalize(acc_obj, pairs, names, revs)
+    orig_m = canonicalize(orig_obj, pairs, names, revs)
+    cand_m = canonicalize(cand_obj, pairs, names, revs)
+    acc_names = sorted(acc["trials"].keys())
+    bc = {"accepted_trials": acc_names}
+    part = {"original_matrix_trials": sorted(orig_m["trials"].keys()),
+            "candidate_matrix_trials": sorted(cand_m["trials"].keys())}
+    part["partition_exact"] = (
+        part["original_matrix_trials"] == acc_names
+        and part["candidate_matrix_trials"] == acc_names
+        and len(acc_names) == 20
+        and set(ORIGINAL_TRIALS) <= set(acc_names))
+    bc["partition"] = part
+    if not part["partition_exact"]:
+        fail("P1_CLOCK_BRANCH_PARTITION", part)
+    div = first_divergence(acc["trials"]["repro_old"],
+                           orig_m["trials"]["repro_old"],
+                           "$.trials.repro_old")
+    bc["original_repro_old"] = {
+        "identical_after_canonicalization": div is None,
+        "first_divergence": div,
+        "gates": orig_m["trials"]["repro_old"].get("gates"),
+        "ok": orig_m["trials"]["repro_old"].get("ok")}
+    if div is not None:
+        fail("P1_CLOCK_ORIGINAL_REPRO", bc["original_repro_old"])
+    cand19 = [n for n in acc_names if n not in ORIGINAL_TRIALS]
+    bad, cells = {}, 0
+    for n in cand19:
+        cells += count_leaves(acc["trials"][n])
+        d = first_divergence(acc["trials"][n], cand_m["trials"][n],
+                             "$.trials." + n)
+        if d is not None:
+            bad[n] = d
+    bc["candidate_19"] = {
+        "trials_compared": len(cand19), "cells_compared": cells,
+        "all_identical": not bad, "divergences": bad,
+        "repro_old_excluded_from_candidate_verdict": True,
+        "candidate_branch_repro_old_recorded_not_adjudicated":
+            cand_m["trials"]["repro_old"]}
+    if bad:
+        fail("P1_CLOCK_ADAPTER_REGRESSION", bc["candidate_19"])
