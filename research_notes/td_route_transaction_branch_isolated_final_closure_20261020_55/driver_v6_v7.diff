+def adjudicate_clock_branches(acc_obj, orig_obj, cand_obj):
+    """Pure partitioned adjudication (spec 6297990771 S.5).
+    Canonicalizes with the unchanged v6 machinery and compares:
+    ORIGINAL repro_old exactly; CANDIDATE other-19 exactly with
+    repro_old excluded; exact trial-name partition; combined
+    rollup reconstructed arithmetically and compared to accepted.
+    Returns the evidence dict; raises Fail on first divergence.
+    No matrix is fabricated or altered."""
