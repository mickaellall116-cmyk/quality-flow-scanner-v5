+    def tripwire_pending(self, now, tripwire_only_hold=False):
+        """True while the CURRENT session's tripwire gate is not
+        satisfied. Corr1 (2026-10-26, Issue #1 comment 6433085265,
+        independent review of the Option B successor): the frozen
+        protocol requires the session's 09:15 ET Gmail tripwire check
+        to run BEFORE that session's first Twelve Data call. The
+        Option B successor left an ordering hole — run_due returned
+        immediately while an inherited hold was active, so the current
+        session's tripwire could not run before clearance; and once
+        clearance lifted the hold, the sorted due loop executed the
+        session's overdue 07:55 pre_revision usage action BEFORE its
+        09:15 tripwire (committed Scenario B output:
+        ['usage|2026-10-27|pre_revision', 'tripwire|2026-10-27']).
+        The gate is satisfied only when the current session's
+        tripwire action is done AND the latest recorded check for the
+        current session is clean. With tripwire_only_hold=True the
+        current session's own tripwire action is not yet actionable
+        (it is served by the hold phase in run_due), so only the
+        recorded-clean limb applies there."""
+        today_s = now.astimezone(ET).date().isoformat()
+        tw = self.st["tripwire"]
+        last = tw["checks"][-1] if tw["checks"] else None
+        recorded_clean = bool(last) \
+            and last.get("session") == today_s \
+            and last.get("outcome") == "clean"
+        if not tripwire_only_hold:
+            cur = next((a for a in self.st["actions"]
+                        if a["kind"] == "tripwire"
+                        and a.get("session") == today_s), None)
+            if cur is not None and cur["status"] == "pending":
+                return True
+        return not recorded_clean
+
