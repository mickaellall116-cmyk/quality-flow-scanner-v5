+    WINDOW_START / WINDOW_END; tiers an object with exactly the
+    tier2 / tier3 lists - non-empty, disjoint, duplicate-free. The
+    inventory hash / census may be null ONLY in the shipped staging
+    template; require_completed_binding bars any run under it."""
+    want = PINNED_MANIFEST_SHA256 if pinned is None else pinned
+    got = sha256_file(manifest_path)
+    if got != want:
+        raise FailClosedError(
+            f"binding manifest sha256 {got} != pinned {want} - "
+            "refusing (caller-supplied hashes are never trusted)")
+    with open(manifest_path) as f:
+        binding = json.load(f)
+    if set(binding) != MANIFEST_KEYS:
+        raise FailClosedError(
+            f"binding manifest key set drift: {sorted(binding)}")
+    if binding["window_start"] != WINDOW_START \
+            or binding["window_end"] != WINDOW_END:
+        raise FailClosedError(
+            "binding manifest window != compiled-in window "
+            f"[{WINDOW_START}, {WINDOW_END}]")
+    tiers = binding["tiers"]
+    if not isinstance(tiers, dict) or set(tiers) != {"tier2", "tier3"}:
+        raise FailClosedError("binding manifest tiers shape drift")
+    t2, t3 = tiers["tier2"], tiers["tier3"]
+    if not t2 or not t3 or set(t2) & set(t3) \
+            or len(t2) != len(set(t2)) or len(t3) != len(set(t3)):
+        raise FailClosedError(
+            "binding manifest tiers empty, duplicated, or overlapping")
+    return binding
+
