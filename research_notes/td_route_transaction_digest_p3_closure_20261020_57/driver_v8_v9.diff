+def proof_digest_check(obj):
+    """-57 corrected digest check (pure): exact structured check of
+    a supplement object. PASS requires: calendar_proofs holds
+    EXACTLY ONE key and it equals EXPECTED_PROOF_DIGEST (field path
+    calendar_proofs.<sole key>), AND every
+    entries.*.calendar_proof_digest equals it. Anything else FAILs.
+    """
+    ev = {"calendar_proofs_field_path": "calendar_proofs.<sole key>",
+          "entries_field_path": "entries.*.calendar_proof_digest",
+          "expected_digest": EXPECTED_PROOF_DIGEST}
+    cp = obj.get("calendar_proofs") if isinstance(obj, dict) else None
+    ev["calendar_proofs_keys"] = (sorted(cp.keys())
+                                  if isinstance(cp, dict) else None)
+    ev["sole_key_equals_expected"] = bool(
+        isinstance(cp, dict) and len(cp) == 1
+        and next(iter(cp)) == EXPECTED_PROOF_DIGEST)
+    ents = obj.get("entries") if isinstance(obj, dict) else None
+    ev["entries_digests"] = (
+        {k: v.get("calendar_proof_digest")
+         for k, v in sorted(ents.items())}
+        if isinstance(ents, dict) else None)
+    ev["entries_all_equal_expected"] = bool(
+        isinstance(ents, dict) and len(ents) > 0
+        and all(v.get("calendar_proof_digest") == EXPECTED_PROOF_DIGEST
+                for v in ents.values()))
+    ev["ok"] = bool(ev["sole_key_equals_expected"]
+                    and ev["entries_all_equal_expected"])
+    return ev
